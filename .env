# above (see scripts/fetch-js-examples.sh). Ignored once a release contains it.
# a5e0bb3c is "Add a React chat example (#1557)". Its packages/ are v0.7.28
# plus #1525 ("Skip every remote Increase that Go skips").
YORKIE_JS_EXAMPLES_REF='a5e0bb3ce6f53edbe2da89409a1b804a3b8f119b'

